# Copia in .env (o .env.local in sviluppo) e compila.

# URL pubblico dell'app, usato nei link delle email.
APP_URL=http://localhost:3000

# MySQL 8 (sulla VPS: database e utente creati da xCloud)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=photo_archive
DATABASE_PASSWORD=
DATABASE_NAME=photo_archive

# SMTP: provider da scegliere. Se SMTP_HOST è vuoto le email
# finiscono nel log del server invece di essere inviate.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Archivio foto <noreply@example.com>"

# Durate (giorni)
SESSION_TTL_DAYS=30
SHARE_LINK_TTL_DAYS=30
