# Copia in .env (o .env.local in sviluppo) e compila.

# URL pubblico dell'app, usato nei link delle email.
APP_URL=http://localhost:3000

# MySQL 8 (sulla VPS: database e utente creati da xCloud)
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=photo_archive
DATABASE_PASSWORD=
DATABASE_NAME=photo_archive

# SMTP: provider da scegliere. Se SMTP_HOST è vuoto le email
# finiscono nel log del server invece di essere inviate.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="Archivio foto <noreply@example.com>"

# Durate (giorni)
SESSION_TTL_DAYS=30
SHARE_LINK_TTL_DAYS=30

# Archivio dei file. "local" salva in una cartella (prove e sviluppo),
# "gcs" usa Google Cloud Storage (produzione).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-locale
# Almeno 32 caratteri casuali (es. `openssl rand -base64 48`).
STORAGE_SIGNING_SECRET=
GCS_BUCKET=
GCS_KEY_FILE=
# oppure il contenuto del file JSON su una riga
GCS_KEY_JSON=

# Riconoscimento dei volti (`npm run volti`, sulla VPS).
# Cartella dei modelli InsightFace (fuori dal repository, ~190 MB).
FACES_MODEL_DIR=./modelli-volti
# Thread di calcolo (pochi: la VPS ospita altri siti).
FACES_THREADS=2
# Lato del rilevatore in px (multiplo di 32): più grande trova volti più piccoli, più lento.
FACES_DET_SIZE=640
# Volti più piccoli di così (px dell'anteprima 2048) vengono ignorati.
FACES_MIN_SIZE=40

# --- Solo sul computer di Antonio, per `npm run import` ---
# Indirizzo dell'app e chiave creata nella pagina Import.
IMPORT_SERVER_URL=https://foto.acasolino.com
IMPORT_KEY=
