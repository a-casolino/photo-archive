{
  "name": "photo-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts --status",
    "owner:create": "tsx scripts/create-owner.ts",
    "import": "tsx scripts/import/index.ts",
    "volti": "tsx --conditions=react-server scripts/volti/index.ts",
    "cestino": "tsx --conditions=react-server scripts/cestino.ts",
    "drive": "tsx --conditions=react-server scripts/drive/index.ts",
    "luoghi": "tsx --conditions=react-server scripts/luoghi/index.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "@uswriting/exiftool": "^1.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "google-auth-library": "^11.3.4",
    "libheif-js": "^1.23.5",
    "lucide-react": "^1.70.0",
    "mysql2": "^3.24.6",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "onnxruntime-node": "^1.31.1",
    "radix-ui": "^1.4.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.7.0",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/yauzl": "^3.4.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "exiftool-vendored": "^39.1.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "description": "Archivio fotografico personale di Antonio (Next.js + MySQL 8 + Google Cloud Storage)",
  "engines": {
    "node": ">=22"
  }
}
