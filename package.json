{
  "name": "photo-archive",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:status": "tsx scripts/migrate.ts --status",
    "owner:create": "tsx scripts/create-owner.ts",
    "import": "tsx scripts/import/index.ts",
    "volti": "tsx --conditions=react-server scripts/volti/index.ts",
    "cestino": "tsx --conditions=react-server scripts/cestino.ts"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.4.0",
    "mysql2": "^3.24.6",
    "next": "16.4.5",
    "nodemailer": "^10.3.1",
    "onnxruntime-node": "^1.31.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "exiftool-vendored": "^39.1.1",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "description": "Archivio fotografico personale di Antonio (Next.js + MySQL 8 + Google Cloud Storage)",
  "engines": {
    "node": ">=22"
  }
}
